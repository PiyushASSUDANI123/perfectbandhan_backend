# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Database (MongoDB Atlas) ───────────────────────────────────────────────────
# Connection string with replica set for HA
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/perfectbandhan?retryWrites=true&w=majority&maxPoolSize=50&minPoolSize=10

# ─── Redis (for caching, rate limiting, pub/sub, Socket.io adapter) ─────────────
REDIS_URL=redis://localhost:6379
# For Redis Cluster (production):
# REDIS_URL=redis://node1:6379,node2:6379,node3:6379
USE_REDIS_CACHE=true

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ─── Firebase (FCM Push Notifications) ──────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-key.json
# Or set individual env vars:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ─── Cloudinary (Image Upload) ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── WhatsApp (WhatsApp Web.js) ─────────────────────────────────────────────────
# Session stored in .wwebjs_auth/

# ─── Google (Gemini AI for bio generation) ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── App Config ──────────────────────────────────────────────────────────────────
APP_LOGO_URL=https://your-cdn.com/logo.png
ADMIN_PHONE=9413879444
ADMIN_PASSWORD=your-admin-password

# ─── Scalability Tuning ─────────────────────────────────────────────────────────
# MongoDB connection pool (handled in db.service.js)
# MONGO_MAX_POOL_SIZE=50
# MONGO_MIN_POOL_SIZE=10

# Rate limiting (per IP)
# OTP: 5/min, Login: 10/15min, Profile write: 30/min, Chat: 20/min, Search: 60/min

# Cache TTLs (seconds)
# Profile cache: 300, Search cache: 60, Config cache: 3600

# Request deduplication TTL (ms)
# DEDUPE_TTL_MS=3000

# Write-behind buffer
# WRITE_BATCH_SIZE=10
# WRITE_FLUSH_INTERVAL_MS=5000

# ─── Feature Flags ──────────────────────────────────────────────────────────────
CHAT_COMING_SOON=false
MAINTENANCE_MODE=false

# ─── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Options: error, warn, info, debug